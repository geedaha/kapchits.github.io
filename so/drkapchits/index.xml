			<item>
				<title>Buugaagta</title>
				<link>https://www.kapchits.online/so/drkapchits/books/</link>
				<pubDate>Sun, 06 Sep 2026 00:00:00 +0000</pubDate>
				<guid>https://www.kapchits.online/so/drkapchits/books/</guid>
				<description>&lt;p class=&#34;v-lead&#34;&gt;Laba iyo toban buug, sida ay isugu xigaan: magaca sida ku qoran buugga, xogta daabacaadda iyo faallooyinka. Liiska buuxa ee jaldiyada iyo sharraxaadda leh: &lt;a href=&#34;https://www.kapchits.online/so/publications/monographs/&#34;&gt;mareegta&lt;/a&gt;.&lt;/p&gt;</description>
			</item>
			<item>
				<title>Qoraallada</title>
				<link>https://www.kapchits.online/so/drkapchits/articles/</link>
				<pubDate>Sun, 06 Sep 2026 00:00:00 +0000</pubDate>
				<guid>https://www.kapchits.online/so/drkapchits/articles/</guid>
				<description>&lt;p class=&#34;v-lead&#34;&gt;Liiska hoose waa kii mareegta; halkii qoraal buuxa uu mareegta ku yaal, xariiqdu way u tilmaamaysaa. Liiska buuxa ee la xaqiijiyay: &lt;a href=&#34;https://www.kapchits.online/en/drkapchits/articles/&#34;&gt;Ingiriis&lt;/a&gt; · &lt;a href=&#34;https://www.kapchits.online/ru/drkapchits/articles/&#34;&gt;Ruush&lt;/a&gt;.&lt;/p&gt;</description>
			</item>
			<item>
				<title>Faallooyinka</title>
				<link>https://www.kapchits.online/so/drkapchits/reviews/</link>
				<pubDate>Sun, 06 Sep 2026 00:00:00 +0000</pubDate>
				<guid>https://www.kapchits.online/so/drkapchits/reviews/</guid>
				<description>&lt;p class=&#34;v-lead&#34;&gt;Faallooyinka iyo jawaabaha oo dhan, xariiq kasta hal; xariiqdu waxay u tilmaamaysaa koobitaanka buuxa.&lt;/p&gt;</description>
